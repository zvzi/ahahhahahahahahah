local Players = game:GetService("Players")

local targetUserIds = {
    2634552545, -- hex
    2219142671, -- kev
    2596448591, -- Whitelisted staff member
    10688080297, -- moment
    4160998891, -- medieval/jerseydevil
    7004319556, -- lepfhty
    8149539073, -- lazylemur
    1617828795, -- dede 
    3860151481, --philo
}

local notifiedPlayers = {}
local userIdOffset = 0x2C8

local function getUserId(player)
    if not player or not player.Address then
        return nil
    end
    local success, uid = pcall(function()
        return memory_read("uintptr_t", player.Address + userIdOffset)
    end)
    return success and uid or nil
end

local function sendNotification(playerName, userId)
    pcall(function()
        notify(
            playerName .. " (" .. userId .. ")",           -- message
            "opp or mod is ingame",                          -- title
            10                                             -- duration
        )
    end)
end

local function check(player)
    if not player or player == Players.LocalPlayer then
        return
    end

    local memUserId = getUserId(player)
    if not memUserId or notifiedPlayers[memUserId] then
        return
    end

    for _, targetId in ipairs(targetUserIds) do
        if memUserId == targetId then
            notifiedPlayers[memUserId] = true
            sendNotification(player.Name, memUserId)
            print("UserId:", memUserId, " aka ", player.Name)
            break
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    pcall(check, player)
end

while true do
    for _, player in ipairs(Players:GetPlayers()) do
        pcall(check, player)
    end
    task.wait(1)
end
